[{"id":"4s","name":"四年级上","units":[{"t":"Unit 1 My classroom","zh":"我的教室","s":[["What's in the classroom?","教室里有什么？"],["A blackboard, a TV and many desks and chairs.","一块黑板、一台电视和许多桌椅。"],["Let's clean the classroom.","我们来打扫教室吧。"],["Where is the picture?","图画在哪里？"],["It's on the wall.","它在墙上。"],["Open the window, please.","请打开窗户。"],["Turn on the light.","打开灯。"],["Let's put up the picture.","我们把画挂起来吧。"]]},{"t":"Unit 2 My schoolbag","zh":"我的书包","s":[["I have a new schoolbag.","我有一个新书包。"],["What's in your schoolbag?","你的书包里有什么？"],["An English book, a maths book and three storybooks.","一本英语书、一本数学书和三本故事书。"],["What color is it?","它是什么颜色的？"],["It's black and white.","它是黑白相间的。"],["Is it heavy?","它重吗？"],["Please give me the notebook.","请把笔记本给我。"],["Is this your pencil box?","这是你的铅笔盒吗？"]]},{"t":"Unit 3 My friends","zh":"我的朋友","s":[["I have a new friend.","我有一个新朋友。"],["What's his name?","他叫什么名字？"],["His name is Tom.","他叫汤姆。"],["He is tall and strong.","他又高又壮。"],["She has long hair.","她有一头长头发。"],["Who is your best friend?","谁是你最好的朋友？"],["My friend is thin and funny.","我的朋友又瘦又有趣。"],["She is quiet and kind.","她安静又善良。"]]},{"t":"Unit 4 My home","zh":"我的家","s":[["Welcome to my home.","欢迎来到我家。"],["There is a living room and a kitchen.","有一间客厅和一间厨房。"],["Where is my key?","我的钥匙在哪里？"],["Is it in the living room?","它在客厅里吗？"],["Is she in the kitchen?","她在厨房里吗？"],["Yes, she is.","是的，她在。"],["No, he isn't.","不，他不在。"],["He is in the study.","他在书房里。"]]},{"t":"Unit 5 Dinner's ready","zh":"晚饭好了","s":[["What would you like to eat?","你想吃什么？"],["I'd like some rice and fish.","我想要一些米饭和鱼。"],["Dinner is ready.","晚饭准备好了。"],["Help yourself.","请随便吃。"],["Would you like some soup?","你想喝点汤吗？"],["Yes, please.","好的，请给我。"],["No, thanks.","不用了，谢谢。"],["The beef is delicious.","牛肉很好吃。"]]},{"t":"Unit 6 Meet my family","zh":"认识我的家人","s":[["This is my family.","这是我的家人。"],["How many people are there in your family?","你家有几口人？"],["There are four people in my family.","我家有四口人。"],["My father is a doctor.","我的爸爸是一名医生。"],["What does your mother do?","你的妈妈是做什么的？"],["She is a teacher.","她是一名老师。"],["My uncle is a driver.","我的叔叔是一名司机。"],["I love my family.","我爱我的家人。"]]}]},{"id":"4x","name":"四年级下","units":[{"t":"Unit 1 My school","zh":"我的学校","s":[["Where is the library?","图书馆在哪里？"],["It's on the first floor.","它在一楼。"],["Is there a playground?","有操场吗？"],["Yes, there is.","是的，有。"],["The art room is next to the music room.","美术室在音乐室旁边。"],["Go to the teacher's office.","去教师办公室。"],["Let's go and see the garden.","我们去看看花园吧。"],["Our school is big and beautiful.","我们的学校又大又漂亮。"]]},{"t":"Unit 2 What time is it?","zh":"几点了","s":[["What time is it?","几点了？"],["It's seven o'clock.","七点了。"],["It's time for breakfast.","到吃早饭的时间了。"],["It's time to go to school.","到上学的时间了。"],["It's time for English class.","到上英语课的时间了。"],["It's time to get up.","到起床的时间了。"],["Let's go to the playground.","我们去操场吧。"],["It's time for lunch.","到吃午饭的时间了。"]]},{"t":"Unit 3 Weather","zh":"天气","s":[["How's the weather today?","今天天气怎么样？"],["It's sunny and warm.","天气晴朗又温暖。"],["It's cold and snowy.","天气又冷又下雪。"],["It's windy today.","今天有风。"],["It's raining outside.","外面在下雨。"],["Take an umbrella.","带上一把伞。"],["Is it hot in Sanya?","三亚热吗？"],["Let's go outside and play.","我们去外面玩吧。"]]},{"t":"Unit 4 At the farm","zh":"在农场","s":[["Are these tomatoes?","这些是西红柿吗？"],["Yes, they are.","是的，它们是。"],["No, they aren't.","不，它们不是。"],["What are those?","那些是什么？"],["They are carrots.","它们是胡萝卜。"],["Look at the ducks.","看那些鸭子。"],["These are potatoes.","这些是土豆。"],["Those are cows.","那些是奶牛。"]]},{"t":"Unit 5 My clothes","zh":"我的衣服","s":[["Whose hat is this?","这是谁的帽子？"],["It's mine.","它是我的。"],["Whose shoes are these?","这些是谁的鞋子？"],["They are hers.","它们是她的。"],["Put on your coat.","穿上你的外套。"],["Is this your jacket?","这是你的夹克吗？"],["Look at the clothes.","看这些衣服。"],["My dress is pink.","我的连衣裙是粉色的。"]]},{"t":"Unit 6 Shopping","zh":"购物","s":[["Can I help you?","需要帮忙吗？"],["I'd like a pair of shoes.","我想要一双鞋。"],["How much are they?","它们多少钱？"],["Try them on, please.","请试穿一下。"],["They are a little small.","它们有一点小。"],["How much is this skirt?","这条裙子多少钱？"],["It's ninety yuan.","九十元。"],["I'll take it.","我要买它。"]]}]}]